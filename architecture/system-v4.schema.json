{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamisdata.local/architecture/system-v4.schema.json",
  "title": "DynamisData multi-sport platform V4 contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_id", "version", "status", "scope", "scientific_core", "sports_semantics", "provider_identity_crosswalk", "data_grain", "source_catalog", "capability_profile", "product_routing", "event_envelope", "spatial_reference", "clock_authority", "storage", "openlineage_export", "backfill", "migration", "out_of_scope", "adr_ids", "acceptance"],
  "properties": {
    "$schema": {"type": "string"},
    "contract_id": {"type": "string", "enum": ["dynamisdata-multisport-platform"]},
    "version": {"type": "string", "enum": ["4.0.0"]},
    "status": {"type": "string", "enum": ["frozen"]},
    "scope": {"type": "string", "minLength": 1},
    "scientific_core": {"$ref": "#/$defs/scientificCore"},
    "sports_semantics": {"$ref": "#/$defs/sportsSemantics"},
    "provider_identity_crosswalk": {"$ref": "#/$defs/crosswalk"},
    "data_grain": {"$ref": "#/$defs/dataGrain"},
    "source_catalog": {"$ref": "#/$defs/sourceCatalog"},
    "capability_profile": {"$ref": "#/$defs/capabilityProfile"},
    "product_routing": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/productRoute"}},
    "event_envelope": {"$ref": "#/$defs/eventEnvelope"},
    "spatial_reference": {"$ref": "#/$defs/spatialReference"},
    "clock_authority": {"$ref": "#/$defs/clockAuthority"},
    "storage": {"$ref": "#/$defs/storage"},
    "openlineage_export": {"$ref": "#/$defs/openLineage"},
    "backfill": {"$ref": "#/$defs/backfill"},
    "migration": {"$ref": "#/$defs/migration"},
    "out_of_scope": {"$ref": "#/$defs/stringArray"},
    "adr_ids": {"$ref": "#/$defs/stringArray"},
    "acceptance": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "object": {"type": "object", "additionalProperties": false},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "scientificCore": {"type": "object", "additionalProperties": false, "required": ["entities", "authorities", "rules"], "properties": {"entities": {"$ref": "#/$defs/stringArray"}, "authorities": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "sportsSemantics": {"type": "object", "additionalProperties": false, "required": ["entities", "competition_edition_kinds", "period_kinds", "contest_rules"], "properties": {"entities": {"$ref": "#/$defs/stringArray"}, "competition_edition_kinds": {"$ref": "#/$defs/stringArray"}, "period_kinds": {"$ref": "#/$defs/stringArray"}, "contest_rules": {"$ref": "#/$defs/stringArray"}}},
    "crosswalk": {"type": "object", "additionalProperties": false, "required": ["fields", "entity_kinds", "merge_rule"], "properties": {"fields": {"$ref": "#/$defs/stringArray"}, "entity_kinds": {"$ref": "#/$defs/stringArray"}, "merge_rule": {"type": "string", "minLength": 1}}},
    "dataGrain": {"type": "object", "additionalProperties": false, "required": ["version", "kinds", "axis_variants", "rule"], "properties": {"version": {"type": "string"}, "kinds": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stringArray"}}, "axis_variants": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stringArray"}}, "rule": {"type": "string", "minLength": 1}}},
    "sourceCatalog": {"type": "object", "additionalProperties": false, "required": ["fields", "object_kinds", "states", "transitions", "rules"], "properties": {"fields": {"$ref": "#/$defs/stringArray"}, "object_kinds": {"$ref": "#/$defs/stringArray"}, "states": {"$ref": "#/$defs/stringArray"}, "transitions": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "capabilityProfile": {"type": "object", "additionalProperties": false, "required": ["vocabulary", "origins", "rules"], "properties": {"vocabulary": {"$ref": "#/$defs/stringArray"}, "origins": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "productRoute": {"type": "object", "additionalProperties": false, "required": ["product", "requires_local_capabilities", "requires_grain", "optional_capabilities"], "properties": {"product": {"type": "string", "enum": ["MatchLab", "GameLab", "SeasonLab", "PerformanceLab"]}, "requires_local_capabilities": {"$ref": "#/$defs/stringArray"}, "requires_grain": {"$ref": "#/$defs/stringArray"}, "optional_capabilities": {"$ref": "#/$defs/stringArray"}}},
    "eventEnvelope": {"type": "object", "additionalProperties": false, "required": ["schema_version", "fields", "rules"], "properties": {"schema_version": {"type": "string"}, "fields": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "spatialReference": {"type": "object", "additionalProperties": false, "required": ["fields", "surfaces", "rules"], "properties": {"fields": {"$ref": "#/$defs/stringArray"}, "surfaces": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "clockAuthority": {"type": "object", "additionalProperties": false, "required": ["concepts", "mapping_fields", "rules"], "properties": {"concepts": {"$ref": "#/$defs/stringArray"}, "mapping_fields": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["semantic_authority", "dense_authority", "artifact_boundaries", "partition_keys", "partition_rules", "table_format"], "properties": {"semantic_authority": {"type": "string"}, "dense_authority": {"type": "string"}, "artifact_boundaries": {"$ref": "#/$defs/stringMap"}, "partition_keys": {"$ref": "#/$defs/stringArray"}, "partition_rules": {"$ref": "#/$defs/stringArray"}, "table_format": {"type": "object", "additionalProperties": false, "required": ["initial", "prohibited_now", "adoption_triggers"], "properties": {"initial": {"type": "string"}, "prohibited_now": {"$ref": "#/$defs/stringArray"}, "adoption_triggers": {"$ref": "#/$defs/stringArray"}}}}},
    "openLineage": {"type": "object", "additionalProperties": false, "required": ["runtime_dependency", "mapping", "authority"], "properties": {"runtime_dependency": {"type": "boolean"}, "mapping": {"$ref": "#/$defs/stringMap"}, "authority": {"type": "string"}}},
    "backfill": {"type": "object", "additionalProperties": false, "required": ["sports", "contest_context_sources", "sport_neutral_sources", "rules"], "properties": {"sports": {"$ref": "#/$defs/stringArray"}, "contest_context_sources": {"$ref": "#/$defs/stringArray"}, "sport_neutral_sources": {"$ref": "#/$defs/stringArray"}, "rules": {"$ref": "#/$defs/stringArray"}}},
    "migration": {"type": "object", "additionalProperties": false, "required": ["entry_sha", "single_worktree", "atomic_commits", "steps", "preserve"], "properties": {"entry_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "single_worktree": {"type": "boolean"}, "atomic_commits": {"type": "boolean"}, "steps": {"$ref": "#/$defs/stringArray"}, "preserve": {"$ref": "#/$defs/stringArray"}}}
  }
}
