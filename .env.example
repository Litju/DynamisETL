# ---------------------------------------------------------------------------
# DynamisData local environment template.
#
# Copy to `.env` and adjust for this workstation:
#     Copy-Item .env.example .env      (Windows PowerShell)
#     cp .env.example .env             (POSIX)
#
# `.env` is git-ignored. Never commit real credentials.
#
# Absolute scientific-data and database-state roots are machine-local
# configuration. Application modules read them from the environment; they are
# never hard-coded in source.
# ---------------------------------------------------------------------------

# --- External roots --------------------------------------------------------
# Repository:      E:\Data\Projects\DynamisETL   (code/config/contracts only)
# Scientific data: E:\Data\Datasets\DynamisETL   (bronze/silver/gold/...)
# Database state:  E:\Data\Databases\DynamisETL  (postgres/duckdb)
DYNAMIS_DATASET_ROOT=E:/Data/Datasets/DynamisETL
DYNAMIS_DATABASE_ROOT=E:/Data/Databases/DynamisETL
DYNAMIS_DUCKDB_PATH=E:/Data/Databases/DynamisETL/duckdb/dynamis.duckdb

# --- PostgreSQL (docker compose) ------------------------------------------
# The official PostgreSQL 18 image persists its cluster under
# /var/lib/postgresql (PG18 changed from the older /var/lib/postgresql/data
# target). docker-compose.yml mounts ${DYNAMIS_DATABASE_ROOT}/postgres there.
POSTGRES_IMAGE=postgres:18.6
POSTGRES_USER=dynamis
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dynamis
POSTGRES_HOST=127.0.0.1
# 5432 may already be occupied by another local PostgreSQL instance.
POSTGRES_PORT=5433

# --- Application database --------------------------------------------------
# SQLAlchemy URL consumed by Alembic, the metadata loader and integration tests.
POSTGRES_URL=postgresql+psycopg://dynamis:change-me-local-only@127.0.0.1:5433/dynamis
DYNAMIS_DB_SCHEMA=dynamis
# Published Gold serving schema (created by `uv run dynamis-gold publish`).
DYNAMIS_GOLD_SCHEMA=gold

# --- Product ports (docker compose --profile product) ----------------------
API_PORT=8000
WEB_PORT=8080

# Integration tests import the PostgreSQL suite when this is set.
DYNAMIS_TEST_POSTGRES_URL=postgresql+psycopg://dynamis:change-me-local-only@127.0.0.1:5433/dynamis

# --- Processor provenance --------------------------------------------------
# Production/container execution injects the exact code revision that produced
# persisted scientific processor runs (40-character lower-case Git SHA). Leave
# empty on a machine with a Git checkout: the revision is then resolved from Git.
DYNAMIS_CODE_GIT_SHA=
# Development-only escape hatch: permit persisted processor runs when no Git
# revision can be resolved. Null-SHA runs are visible in provenance and are
# refused by the Gold serving publication gate. Never enable in production.
DYNAMIS_ALLOW_UNKNOWN_CODE_SHA=0
