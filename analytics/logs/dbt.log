    create  table
      "dynamis_gold"."main"."gold_session_player_load__dbt_tmp"
  
    
    as (
      -- Session/subject/entity load summary. Aggregation and pivoting of processor
-- outputs only: no filtering, derivative, integration or biomechanics is
-- defined here.
select
    dataset_id,
    session_id,
    subject_id,
    entity_id,
    algorithm_id,
    count(*) filter (where metric_id like 'locomotor.%') as locomotor_metric_count,
