{
    "schema_version": "1.0.0",
    "source_authority": {
        "dataset": "SkillCorner Open Data Body Pose",
        "measurement_class": "MODEL_ESTIMATED",
        "sample_rate_hz": 25,
        "provider_error_field": "p90_mae_cm",
        "provider_error_unit": "cm",
        "provider_error_semantics": "90th-percentile predicted error radius relative to the player's pose; not probability, confidence, or a confidence interval",
        "coordinate_frame": "skillcorner-pose-hybrid-m",
        "coordinate_semantics": "pitch-global X/Y and player-centroid-relative Z; not a globally registered 3D pitch frame",
    },
    "algorithms": [
        {
            "algorithm_id": "pose.translation_invariant_kinematics",
            "version": "1.0.0",
            "status": "implemented",
            "measurement_class": "PIPELINE_DERIVED",
            "sampling_rate": "read from source stream metadata",
            "gap_policy": {
                "strategy": "contiguous_segments",
                "default_max_gap_factor": 1.5,
                "interpolation": "none",
                "filter_and_derivative_state": "reset at every temporal segment",
            },
            "metrics": [
                {
                    "id_pattern": "pose.segment_length_mean.{segment}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented",
                    "definition": "Mean Euclidean distance between explicitly named available landmarks.",
                },
                {
                    "id_pattern": "pose.segment_length_error_bound.{segment}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented_optional",
                    "definition": "Maximum named worst-case additive endpoint provider-radius bound e_start + e_end; not a confidence interval.",
                },
                {
                    "id_pattern": "pose.angular_rom.{angle}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented",
                    "definition": "Maximum minus minimum of an explicitly named three-landmark included-angle series.",
                },
                {
                    "id_pattern": "pose.angular_velocity_peak.{angle}",
                    "layer": "B",
                    "unit": "rad/s",
                    "status": "implemented",
                    "definition": "Maximum absolute derivative of the filtered angle series within valid contiguous segments.",
                },
                {
                    "id_pattern": "pose.angular_velocity_rms.{angle}",
                    "layer": "B",
                    "unit": "rad/s",
                    "status": "implemented",
                    "definition": "Root-mean-square angle derivative over valid samples in contiguous segments.",
                },
                {
                    "id_pattern": "pose.availability.{landmark}",
                    "layer": "0/D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Fraction of entity frames where the named landmark is available and finite.",
                },
                {
                    "id_pattern": "pose.error_radius_mean.{landmark}",
                    "layer": "0",
                    "unit": "m",
                    "status": "implemented",
                    "definition": "Mean provider p90 predicted error radius over available observations; retains provider semantics.",
                },
            ],
            "series_columns": [
                "entity_id",
                "t_rel_ns",
                "segment_index",
                "segment_{name}_length_m",
                "angle_{name}_rad",
                "angular_velocity_{name}_rad_s",
            ],
            "provenance_required": [
                "subject_id",
                "session_id",
                "trial_id",
                "stream_id",
                "source_checksum",
                "coordinate_frame_id",
                "measurement_class",
                "algorithm_id",
                "algorithm_version",
                "parameters",
                "code_sha",
                "segment_index",
                "gap_policy",
            ],
        },
        {
            "algorithm_id": "pose.landmark_kinematics",
            "version": "1.0.0",
            "status": "implemented",
            "measurement_class": "PIPELINE_DERIVED",
            "metrics": [
                {
                    "id_pattern": "pose.landmark.coverage.{landmark}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Fraction of source frames where the named landmark and explicit body anchor are both available.",
                },
                {
                    "id_pattern": "pose.landmark.displacement_from_range_start.{landmark}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented_when_observed",
                    "definition": "Distance at the last available observation from the first available body-anchor-relative point in the processor range.",
                },
                {
                    "id_pattern": "pose.landmark.path_length.{landmark}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented_when_observed",
                    "definition": "Sum of consecutive body-anchor-relative displacement magnitudes within valid temporal segments; resets across gaps.",
                },
                {
                    "id_pattern": "pose.landmark.speed_mean.{landmark}",
                    "layer": "B",
                    "unit": "m/s",
                    "status": "implemented_when_valid",
                    "definition": "Mean norm of the configured derivative of body-anchor-relative XYZ in the provider hybrid axes; not global landmark speed.",
                },
                {
                    "id_pattern": "pose.landmark.speed_peak.{landmark}",
                    "layer": "B",
                    "unit": "m/s",
                    "status": "implemented_when_valid",
                    "definition": "Peak norm of the configured derivative of body-anchor-relative XYZ in the provider hybrid axes.",
                },
                {
                    "id_pattern": "pose.landmark.acceleration_peak.{landmark}",
                    "layer": "B",
                    "unit": "m/s^2",
                    "status": "disabled_by_default",
                    "definition": "Peak norm of the second derivative; requires explicit provider-radius and minimum-segment gates.",
                },
            ],
            "current_acceptance_landmarks": ["lHip", "rHip", "lKnee", "rKnee", "lAnkle", "rAnkle"],
            "body_anchor_landmark": "midHip",
            "acceleration_default": "disabled",
            "coordinate_semantics": "body-anchor-relative coordinates in the SkillCorner hybrid axes; not global displacement, global speed, or absolute vertical motion",
            "series_name": "pose_landmark_kinematics",
            "series_columns_per_landmark": [
                "relative_position_x_{landmark}_m",
                "relative_position_y_{landmark}_m",
                "relative_position_z_{landmark}_m",
                "displacement_from_range_start_{landmark}_m",
                "path_length_{landmark}_m",
                "body_relative_speed_{landmark}_m_s",
                "available_{landmark}",
            ],
        },
        {
            "algorithm_id": "pose.analysis_quality",
            "version": "1.1.0",
            "status": "implemented",
            "measurement_class": "PIPELINE_DERIVED",
            "metrics": [
                {
                    "id_pattern": "pose.quality.coverage.any_pose_present",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Fraction of cadence-expected frames with any source Pose row within the subject's first-to-last observed span.",
                },
                {
                    "id_pattern": "pose.quality.coverage.any_usable_pose",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Fraction of cadence-expected frames with at least one available finite landmark.",
                },
                {
                    "id_pattern": "pose.quality.availability.{landmark}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Fraction of cadence-expected frames with the named landmark available and finite.",
                },
                {
                    "id_pattern": "pose.quality.coverage.metric.{metric}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented_when_configured",
                    "definition": "Fraction of cadence-expected frames with every configured metric landmark available and finite.",
                },
                {
                    "id_pattern": "pose.quality.dropout_count.{landmark}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Count of contiguous missing/unavailable intervals on the explicit cadence grid.",
                },
                {
                    "id_pattern": "pose.quality.longest_dropout.{landmark}",
                    "layer": "D",
                    "unit": "s",
                    "status": "implemented",
                    "definition": "Longest missing/unavailable interval on the explicit cadence grid.",
                },
                {
                    "id_pattern": "pose.quality.provider_error_radius_mean.{landmark}",
                    "layer": "0",
                    "unit": "m",
                    "status": "implemented_when_available",
                    "definition": "Mean over provider p90 predicted error-radius samples; provider p90-radius semantics are preserved.",
                },
                {
                    "id_pattern": "pose.quality.provider_error_radius_median.{landmark}",
                    "layer": "0",
                    "unit": "m",
                    "status": "implemented_when_available",
                    "definition": "Median over provider p90 predicted error-radius samples; provider p90-radius semantics are preserved.",
                },
                {
                    "id_pattern": "pose.quality.provider_error_radius_p95.{landmark}",
                    "layer": "0",
                    "unit": "m",
                    "status": "implemented_when_available",
                    "definition": "95th percentile over provider p90 predicted error-radius samples; provider p90-radius semantics are preserved.",
                },
                {
                    "id_pattern": "pose.quality.derivative_eligible_fraction.{metric}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented_when_configured",
                    "definition": "Fraction of expected frames in a contiguous complete-metric run meeting the configured minimum frame count; records derivative settings and is not itself a derivative.",
                },
            ],
            "frame_grid": "nominal_sampling_rate_hz_or_median_observed_step",
            "availability_rule": "is_available_and_finite_xyz",
            "minimum_derivative_segment_frames": 3,
            "error_radius_quantile_method": "linear",
            "series_columns": [
                "entity_id",
                "t_rel_ns",
                "any_pose_present",
                "any_pose_available",
                "available_landmark_count",
                "expected_landmark_count",
            ],
            "dropout_interval_series": "pose_quality_dropout_intervals",
            "dropout_interval_series_columns": [
                "entity_id",
                "joint_name",
                "t_rel_ns",
                "start_ns",
                "end_ns_exclusive",
                "missing_frames",
                "duration_s",
            ],
        },
        {
            "algorithm_id": "pose.bilateral_geometry",
            "version": "1.1.0",
            "status": "implemented",
            "measurement_class": "PIPELINE_DERIVED",
            "metrics": [
                {
                    "id_pattern": "pose.bilateral.coverage.{pair}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Common available exact-time frame fraction for the named pair within one subject.",
                },
                {
                    "id_pattern": "pose.bilateral.angle_difference_mean.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented",
                    "definition": "Mean right-minus-left geometric included-angle difference at matched subject/timestamp rows.",
                },
                {
                    "id_pattern": "pose.bilateral.angle_difference_mean_absolute.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented",
                    "definition": "Mean absolute right-minus-left geometric included-angle difference on common samples.",
                },
                {
                    "id_pattern": "pose.bilateral.angle_difference_rms.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented",
                    "definition": "Root-mean-square right-minus-left geometric included-angle difference on common samples.",
                },
                {
                    "id_pattern": "pose.bilateral.angle_difference_range.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented_when_two_samples",
                    "definition": "Range of the right-minus-left geometric included-angle difference.",
                },
                {
                    "id_pattern": "pose.bilateral.waveform_correlation.{pair}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented_when_nonconstant",
                    "definition": "Descriptive Pearson correlation on common exact-time samples; no normative threshold.",
                },
                {
                    "id_pattern": "pose.bilateral.maximum_angle_time_offset.{pair}",
                    "layer": "D",
                    "unit": "s",
                    "status": "implemented_when_unique_maxima",
                    "definition": "Right maximum-angle timestamp minus left maximum-angle timestamp, emitted only when both maxima are unique.",
                },
            ],
            "alignment": "same_subject_exact_canonical_timestamp",
            "difference_convention": "right_minus_left",
            "normative_assessment": false,
            "series_name": "pose_bilateral_geometry",
            "series_columns": [
                "entity_id",
                "t_rel_ns",
                "left_{pair}_rad",
                "right_{pair}_rad",
                "right_minus_left_{pair}_rad",
                "common_available_{pair}",
            ],
        },
        {
            "algorithm_id": "pose.biomechanical_ik",
            "version": "blocked_by_sufficiency_gate",
            "status": "unavailable",
            "measurement_class": "MODEL_ESTIMATED",
            "reason": "Current 29-landmark source evidence does not identify supported anatomical joint coordinate systems or validated model residuals/DOFs.",
        },
        {
            "algorithm_id": "pose.range_summary",
            "version": "1.1.0",
            "status": "implemented_on_demand",
            "measurement_class": "PIPELINE_DERIVED",
            "input_rule": "Exact canonical from/to windows from the raw source and current versioned processor series; display-reduced samples are rejected.",
            "metrics": [
                {
                    "id_pattern": "pose.range.coverage.*",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Pose/frame/selected-landmark coverage over the selected cadence-grid range.",
                },
                {
                    "id_pattern": "pose.range.dropout_count.{landmark}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented",
                    "definition": "Number of contiguous cadence-grid intervals without an available finite source landmark in the exact range.",
                },
                {
                    "id_pattern": "pose.range.longest_dropout.{landmark}",
                    "layer": "D",
                    "unit": "s",
                    "status": "implemented",
                    "definition": "Longest unavailable cadence-grid interval in the selected range; does not infer tracking presence.",
                },
                {
                    "id_pattern": "pose.range.landmark.displacement.{landmark}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented_when_observed",
                    "definition": "First-to-last available body-anchor-relative displacement in the exact range.",
                },
                {
                    "id_pattern": "pose.range.landmark.path_length.{landmark}",
                    "layer": "A",
                    "unit": "m",
                    "status": "implemented_when_observed",
                    "definition": "Sum of consecutive exact body-anchor-relative displacement magnitudes in the selected range; gaps are not bridged.",
                },
                {
                    "id_pattern": "pose.range.landmark.speed_{mean|peak}.{landmark}",
                    "layer": "B",
                    "unit": "m/s",
                    "status": "implemented_when_observed",
                    "definition": "Summary of the versioned body-anchor-relative hybrid-axis speed series in the exact range.",
                },
                {
                    "id_pattern": "pose.range.angle_rom.{angle}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented_when_defined",
                    "definition": "Max-minus-min of an explicitly named geometric included-angle processor series within the exact range.",
                },
                {
                    "id_pattern": "pose.range.angular_velocity_peak.{angle}",
                    "layer": "B",
                    "unit": "rad/s",
                    "status": "implemented_when_defined",
                    "definition": "Peak absolute value of the versioned angular-velocity series within the exact range.",
                },
                {
                    "id_pattern": "pose.range.bilateral.coverage.{pair}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented_when_pair_available",
                    "definition": "Common exact-timestamp bilateral angle-frame fraction in the selected range.",
                },
                {
                    "id_pattern": "pose.range.bilateral.angle_difference_mean_absolute.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented_when_pair_available",
                    "definition": "Mean absolute right-minus-left geometric included-angle difference in the exact range.",
                },
                {
                    "id_pattern": "pose.range.bilateral.angle_difference_rms.{pair}",
                    "layer": "D",
                    "unit": "rad",
                    "status": "implemented_when_pair_available",
                    "definition": "Root-mean-square right-minus-left geometric included-angle difference in the exact range.",
                },
                {
                    "id_pattern": "pose.range.bilateral.waveform_correlation.{pair}",
                    "layer": "D",
                    "unit": "1",
                    "status": "implemented_when_nonconstant",
                    "definition": "Descriptive Pearson correlation over exact common bilateral samples; no normative threshold.",
                },
                {
                    "id_pattern": "pose.range.provider_error_radius_{mean|median|p95}.{landmark}",
                    "layer": "0",
                    "unit": "m",
                    "status": "implemented_when_available",
                    "definition": "Statistic over provider p90 predicted error-radius samples within the exact range; not confidence or probability.",
                },
            ],
            "report_provenance": [
                "subject_id",
                "session_id",
                "trial_id",
                "stream_id",
                "from_ns",
                "to_ns",
                "processor versions",
                "code SHA",
                "input artifact checksums",
            ],
        },
    ],
}
